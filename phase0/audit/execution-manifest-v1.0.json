  },
  "subject_binding": {
    "kind": "manifest_carrier_commit",
    "required_ancestor": "a806bbaa573d28f1460d18110f7974189ca19213",
    "note": "The manifest cannot contain the hash of the commit that contains itself. The runner requires a clean checkout, proves that manifest and runner bytes are the HEAD blobs, and records HEAD commit/tree plus both file digests. Two qualifying reports must bind the same tuple."
  },
  "environment": {
    "network": "not_used_by_registered_detectors",
    "isolation": "fresh full git archive and locally committed baseline per case; no source symlinks; fixed-path checksummed controller Git with replacement refs disabled",
    "variables": {
      "LC_ALL": "C",
      "TZ": "UTC",
      "PYTHONHASHSEED": "0",
      "PYTHONNOUSERSITE": "1"
    }
  },
  "c9_rebinding_policy": {
    "version": "1.0.0",
    "live_run_precedes_qualifying_audits": true,
    "live_rerun_required_after_changes_to": [
      "any tracked byte in a new candidate commit before qualification completes"
    ],
    "why_tests_rebind": "README step 0 executes tests; a tests-only fix changes the documented C9 pipeline.",
    "rebind_without_provider_rerun_only_for": [
      "none; evidence publication is a descendant record about the qualified carrier, not a rebound candidate"
    ],
    "default_for_unclassified_change": "live_rerun_required_for_any_new_candidate_commit",
    "provider_failure_fields": [
      "failure_class",
      "reachability_stage",
      "access_class_conclusion",
      "http_status",
      "bytes_received",
      "expected_sha256",
      "observed_sha256",
      "content_validation_result"
    ],
    "failure_classes": [
      "preflight_failure",
      "local_workflow_failure",
      "local_environment_failure",
      "transport_failure",
      "http_failure",
      "authentication_or_interstitial",
      "digest_mismatch",
      "content_validation_failure",
      "unclassified_retrieval_failure",
      "success"
    ]
  },
