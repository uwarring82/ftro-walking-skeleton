          "path": "data/raw/igs/igs21983.clk.Z",
          "acquisition_mode": "preexisting_local_copy_authenticated_before_any_decode",
          "registered_route": "https://garner.ucsd.edu/pub/products/2198/igs21983.clk.Z",
          "expected_outer_sha256": "9280fcd3697cf425bd3ea1fa144daf52f6622c891181b5340516e318e75975e6",
          "expected_outer_size_bytes": 1603895,
