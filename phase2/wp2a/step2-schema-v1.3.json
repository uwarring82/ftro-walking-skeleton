          "registered_route": "https://garner.ucsd.edu/pub/products/2199/igr21991.clk.Z",
          "expected_outer_sha256": "2ead2464f8981f92bf2b6d18560ea741f17ef57f586e52590761354703c51f34",
          "expected_outer_size_bytes": 1044279,
