          "registered_route": "https://zenodo.org/api/records/17107693/files/ROCIT%20campaign%20results.zip/content",
          "expected_outer_sha256": "6168e24a0c29ce0929e9651460f11ea77f151176e1ba3d0fe3428e1e08bd56bd",
