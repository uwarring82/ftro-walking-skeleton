  "model_semantics": {
    "basis": "registered_convention",
    "output_identifier_form": "urn:sha256:<64 lowercase hexadecimal characters>",
    "output_identifier_denotes": "one exact transformation-output byte state",
    "M1": {
      "name": "explicit output node",
      "requirement": "The graph contains a separate node description whose @id is the output identifier, whose @type includes ftro:TransformationOutput, and whose digest and size describe that byte state."
    },
    "M2": {
      "name": "assertion-carried output identity",
      "requirement": "A named transformation assertion carries source occurrence, procedure, output identifier, digest and size. The output identifier may be an RDF resource reference, but no separate node description and no rdf:type ftro:TransformationOutput statement for that identifier is present."
    },
    "shared_requirements": [
      "The output identifier is distinct from the assertion identifier.",
      "The output identifier occurs as subject or object of a non-presentation statement.",
      "A bare digest literal, a dangling identifier with no transformation relation, a self-loop and reuse of the assertion identifier as the output identifier do not satisfy output addressability."
    ],
    "basis_pointers": [
      "phase2/wp2a/contract-v1.3.md#3-the-two-models",
      "phase2/wp2a/queries-v1.3.json#/queries/Q9"
    ]
  },
