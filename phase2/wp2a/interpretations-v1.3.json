    "execution_status": {
      "basis": "registered_convention",
      "question": "Was the verification procedure named on this assertion executed in the cited run or durable carrier?",
      "enum": {
        "reproduced": "the named procedure executed and its result is in the cited durable evidence",
        "historical_recorded_not_reexecuted": "a historical execution is recorded but the current procedure did not reproduce it",
        "not_attempted": "the named procedure has not run"
      },
      "scope_rule": "Every status names its procedure and evidence carrier; `reproduced` never means merely that related code ran somewhere in repository history."
    }
