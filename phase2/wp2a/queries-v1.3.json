      "cardinality": "per_assertion",
      "record_key": "assertion_id",
      "question": "What is asserted, on which evidence, with what independent evidence, verification and execution states, and with which bitemporal bounds?",
      "fields": [
        "assertion_id",
        "transformation_id",
        "subject",
        "predicate",
        "object",
        "evidence_artifacts",
        "evidence_state",
        "verification_result",
        "execution_status",
        "execution_procedure",
        "temporal.valid_from.value",
        "temporal.valid_from.bound_state",
        "temporal.valid_from.not_later_than",
        "temporal.valid_to.value",
        "temporal.valid_to.bound_state",
        "temporal.known_from.value",
        "temporal.known_from.bound_state",
        "temporal.known_from.not_earlier_than",
        "temporal.known_from.not_later_than",
        "temporal.known_to.value",
        "temporal.known_to.bound_state",
        "basis_pointers"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q7",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q7",
        "M1xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xB/Q7",
        "M2xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xB/Q7"
      },
      "conditional_fields": {
        "when": "temporal.known_from.bound_state == pending_step2_interval",
        "expected_tokens": [
          "${STEP2_REPORT#/started_utc}",
          "${STEP2_REPORT#/ended_utc}"
        ],
        "resolution_rule": "After step2_supports, substitute the two registered whole-value tokens from the immutable bound report before fixture comparison. Before that outcome the evidence gate halts the trial."
      },
      "correction": "v1.2 omitted valid_from.not_later_than and represented known_from as an unsupported exact retrieval timestamp."
    },
    "Q8": {
      "category": "state_axis_separation",
      "applies_to": [
        "M1xA",
        "M2xA"
      ],
      "cardinality": "per_product",
      "record_key": "product_name",
      "question": "Does the model keep container accessibility, report accessibility, assertion verification and named-procedure execution as separate facts?",
      "fields": [
        "product_name",
        "sio_container_evidence_state",
        "bkg_container_evidence_state",
        "historical_bkg_report_evidence_state",
        "sio_assertion_verification_result",
        "sio_assertion_execution_status",
        "bkg_assertion_verification_result",
        "bkg_assertion_execution_status"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q8",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q8"
      }
    },
    "Q9": {
      "category": "output_identity_representation",
      "applies_to": [
        "M1xA",
        "M2xA",
        "M1xB",
        "M2xB"
      ],
      "cardinality": "per_distinct_output",
      "record_key": "output_identifier",
      "question": "Is each output byte state addressable, and is its identifier represented by a separate typed output-node description or only by a named transformation assertion?",
      "fields": [
        "output_identifier",
        "output_sha256",
        "denotes_exact_byte_state",
        "identifier_distinct_from_assertion_id",
        "occurs_in_non_presentation_statement",
        "separate_node_description_present",
        "transformation_output_type_present"
      ],
      "model_specific_expectations": {
        "M1": {
          "denotes_exact_byte_state": true,
          "identifier_distinct_from_assertion_id": true,
          "occurs_in_non_presentation_statement": true,
          "separate_node_description_present": true,
          "transformation_output_type_present": true
        },
        "M2": {
          "denotes_exact_byte_state": true,
          "identifier_distinct_from_assertion_id": true,
          "occurs_in_non_presentation_statement": true,
          "separate_node_description_present": false,
          "transformation_output_type_present": false
        }
      },
      "non_presentation_predicates": [
        "ftro:decodesToByteState",
        "ftro:decodesToSameByteStateAs",
        "ftro:extractsToByteState"
      ],
      "rejects": [
        "bare digest literal without an output identifier",
        "assertion identifier reused as output identifier",
        "identifier occurring only in ftro:display_name or another presentation field",
        "self-loop added solely to make the identifier appear as subject or object"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q9",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q9",
        "M1xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xB/Q9",
        "M2xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xB/Q9"
      }
    }
  },
  "trial_decision_function": {
    "model_relation": {
      "statement": "For each family, M1 is the corresponding M2 graph plus one separately described ftro:TransformationOutput node per distinct output and the statements that type and describe that node; no M2 statement or normalized Q1-Q8 fact is removed or changed.",
      "pass_implication": "M2_F == true implies M1_F == true for each F in {A, B}.",
      "violation_meaning": "M2_F == true and M1_F == false is not evidence that M2 is more expressive; it is an evaluator, fixture-construction or registered model-relation assurance failure."
    },
    "gate_precedence": [
      {
        "rank": 1,
        "when": "any registered detection mutation is not detected, or any registered presentation-only mutation is detected",
        "outcome": "mutation_assurance_failed"
      },
      {
        "rank": 2,
        "when": "a mutation, reset, evaluator or required query did not execute",
        "outcome": "not_executed"
      },
      {
        "rank": 3,
        "when": "required evidence remains insufficient after the bound Step-2 run",
        "outcome": "indeterminate_evidence"
      },
      {
        "rank": 4,
        "when": "M2_A is true while M1_A is false, or M2_B is true while M1_B is false",
        "outcome": "model_relation_assurance_failed"
      },
      {
        "rank": 5,
        "when": "none of ranks 1-4 applies",
        "outcome": "lookup boolean_matrix by M1_A, M1_B, M2_A, M2_B"
      }
    ],
    "boolean_matrix": [
      {
        "M1_A": false,
        "M1_B": false,
        "M2_A": false,
        "M2_B": false,
        "outcome": "neither_supported"
      },
      {
        "M1_A": false,
        "M1_B": true,
        "M2_A": false,
        "M2_B": false,
        "outcome": "split_by_family"
      },
      {
        "M1_A": false,
        "M1_B": true,
        "M2_A": false,
        "M2_B": true,
        "outcome": "split_by_family"
      },
      {
        "M1_A": true,
        "M1_B": false,
        "M2_A": false,
        "M2_B": false,
        "outcome": "split_by_family"
      },
      {
        "M1_A": true,
        "M1_B": false,
        "M2_A": true,
        "M2_B": false,
        "outcome": "split_by_family"
      },
      {
        "M1_A": true,
        "M1_B": true,
        "M2_A": false,
        "M2_B": false,
        "outcome": "encoded_decoded_supported"
      },
      {
        "M1_A": true,
        "M1_B": true,
        "M2_A": false,
        "M2_B": true,
        "outcome": "split_by_family"
      },
      {
        "M1_A": true,
        "M1_B": true,
        "M2_A": true,
        "M2_B": false,
        "outcome": "split_by_family"
      },
      {
        "M1_A": true,
        "M1_B": true,
        "M2_A": true,
        "M2_B": true,
        "outcome": "equivalent_for_registered_queries"
      }
    ],
    "matrix_assertions": {
      "n_rows": 9,
      "all_model-relation-consistent_boolean_tuples_present_once": true,
      "rows_mutually_exclusive": true,
      "rows_exhaustive_after_model_relation_gate": true,
      "n_boolean_tuples_caught_by_model_relation_gate": 7,
      "split_definition": "split_by_family if and only if M1_A != M1_B or M2_A != M2_B"
    },
    "deficiency_closure": {
      "encoded_decoded_supported": true,
      "equivalent_for_registered_queries": true,
      "neither_supported": false,
      "split_by_family": false,
      "indeterminate_evidence": false,
      "not_executed": false,
      "mutation_assurance_failed": false,
      "model_relation_assurance_failed": false
    }
  },
  "evaluator_freeze": {
    "implementation": "phase2/wp2a/evaluate_v1_3.py",
    "binding": "phase2/wp2a/evaluator-binding-v1.3.json",
    "timing": "Both files are committed and digest-bound after step2_supports and before any of the four fixture bytes exist.",
    "binding_must_include": [
      "evaluator_sha256",
      "queries_sha256",
      "expected_answers_sha256",
      "interpretations_sha256",
      "source_facts_sha256",
      "step2_report_sha256",
      "decision_function_sha256",
      "expected fixture identifiers M1xA, M2xA, M1xB, M2xB"
    ],
    "pre_fixture_test_scope": "synthetic evaluator self-tests only; no trial fixture may be opened",
    "change_rule": "Any evaluator change after a fixture exists requires a new contract version and new fixture identifiers; existing fixtures are permanently non-qualifying."
  }
}
