      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q3",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q3",
        "M1xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xB/Q3",
        "M2xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xB/Q3"
      },
      "correction": "v1.2 used per-output cardinality and therefore collapsed the two Family-A source transformations that share one decoded output. v1.3 expects six transformation records in Family A and one in Family B."
    },
    "Q4": {
      "category": "archive_selection",
      "applies_to": [
        "M1xB",
        "M2xB"
      ],
      "cardinality": "per_transformation",
      "record_key": "transformation_id",
      "question": "Which authenticated archive-member selector was applied?",
      "fields": [
        "transformation_id",
        "member_selector"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xB/Q4",
        "M2xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xB/Q4"
