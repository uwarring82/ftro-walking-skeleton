  "version": "1.3.0",
  "date": "2026-08-31",
  "status": "pre-registered; evaluator not yet written",
  "contract": "phase2/wp2a/contract-v1.3.md",
  "supersedes": "phase2/wp2a/queries-v1.2.json (rejected before execution)",
