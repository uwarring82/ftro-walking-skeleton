  "query_result_contract": {
    "answer_shape": "Each query emits an array of records. Each record contains exactly the registered fields for that query, with no missing or additional field.",
    "cardinality_rule": "For fixture model M and family F, record count equals cardinality_vocabulary[query.cardinality][F].",
    "ordering_rule": "Records are sorted lexicographically by the query's record_key before comparison; source or JSON-LD serialization order is irrelevant.",
    "applicability_rule": "A query is applicable if and only if the fixture identifier occurs in query.applies_to.",
    "expected_value_rule": "For each fixture, the evaluator reads the one exact array named by expected_answer_pointer_by_fixture. Only the two whole-value Step-2 timestamp tokens declared by expected-answers-v1.3.json may be substituted; an evaluator may not hand-code, join or derive a second copy.",
    "model_pass_rule": "A model passes a family if and only if every applicable query executes and every result exactly matches its expected records and cardinality."
  },
  "queries": {
    "Q1": {
      "category": "retrieval",
      "applies_to": [
        "M1xA",
        "M2xA",
        "M1xB",
        "M2xB"
      ],
      "cardinality": "per_retrieval_occurrence",
      "record_key": "retrieval_id",
      "question": "Which exact container bytes were retrieved, from which route, at which recorded time, by which procedure?",
      "fields": [
        "retrieval_id",
        "concept_id",
        "route",
        "procedure",
        "retrieved_utc",
        "outer_sha256",
        "outer_size_bytes"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q1",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q1",
        "M1xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xB/Q1",
        "M2xB": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xB/Q1"
      }
    },
    "Q2": {
      "category": "retrieval_identity",
      "applies_to": [
        "M1xA",
        "M2xA"
      ],
      "cardinality": "per_product",
      "record_key": "product_name",
      "question": "Are the SIO and BKG occurrences of one product distinguishable as two container byte identities while retaining the same concept?",
      "fields": [
        "product_name",
        "concept_id",
        "sio_retrieval_id",
        "sio_outer_sha256",
        "bkg_retrieval_id",
        "bkg_outer_sha256",
        "container_identities_distinct"
      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q2",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q2"
      }
    },
    "Q3": {
      "category": "transformation",
      "applies_to": [
        "M1xA",
        "M2xA",
        "M1xB",
        "M2xB"
      ],
      "cardinality": "per_transformation",
      "record_key": "transformation_id",
      "question": "For every source occurrence, which named procedure produced which addressable output byte state?",
      "fields": [
