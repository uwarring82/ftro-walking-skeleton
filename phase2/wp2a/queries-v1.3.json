  },
  "fixtures": {
    "M1xA": {
      "model": "M1",
      "family": "A"
    },
    "M2xA": {
      "model": "M2",
      "family": "A"
    },
    "M1xB": {
      "model": "M1",
      "family": "B"
    },
    "M2xB": {
      "model": "M2",
      "family": "B"
    }
  },
  "cardinality_vocabulary": {
    "per_retrieval_occurrence": {
      "A": 6,
      "B": 1
    },
    "per_product": {
      "A": 3,
      "B": 1
    },
    "per_transformation": {
      "A": 6,
      "B": 1
    },
    "per_distinct_output": {
      "A": 3,
      "B": 1
