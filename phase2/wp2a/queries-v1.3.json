      ],
      "expected_answer_pointer_by_fixture": {
        "M1xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M1xA/Q5b",
        "M2xA": "phase2/wp2a/expected-answers-v1.3.json#/fixtures/M2xA/Q5b",
