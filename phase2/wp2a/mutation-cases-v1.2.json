  "R11": {
    "operator": "R11",
    "expected_observation": "not_detected",
    "target_scope": "every entity in the fixture",
    "enumerated_at": "recipe freeze (step 4), because fixture entity counts do not exist until step 3",
    "correction": "v1.1 required ftro:display_name on EVERY entity but registered only ONE mutation per fixture, so most entities were never shown to be presentation-inert.",
    "validation_rule": "mutation-recipes-v1.2.json MUST contain exactly one R11 case per entity in each fixture, and the recipe checker MUST assert that count equals the fixture's entity count. A shortfall is not_executed for the whole operator, which fails the run.",
    "n_cases": "determined_at_recipe_freeze"
  },
  "outcome_vocabulary": [
    "detected",
    "not_detected",
    "not_executed",
    "assurance_failed"
  ],
  "outcome_rules": [
    {
      "when": "mutation did not change the fixture, evaluator did not run, or reset unverified",
      "outcome": "not_executed",
      "run_verdict": "fail"
    },
    {
      "when": "expected detected AND observed detected",
      "outcome": "detected",
      "run_verdict": "pass"
    },
    {
      "when": "expected not_detected AND observed not_detected",
      "outcome": "not_detected",
      "run_verdict": "pass"
    },
    {
      "when": "expected detected AND observed not_detected",
      "outcome": "assurance_failed",
      "run_verdict": "fail"
    },
    {
      "when": "expected not_detected AND observed detected",
      "outcome": "assurance_failed",
      "run_verdict": "fail"
    }
  ],
  "trial_level_consequence": "Any assurance_failed in a qualifying run yields trial outcome mutation_assurance_failed and BLOCKS every model verdict.",
  "fixture_requirements": [
    {
      "id": "F-REQ-1",
      "requirement": "Every entity carries an addressable @id.",
      "tested_by": "Q9"
    },
    {
      "id": "F-REQ-2",
      "requirement": "Every assertion declares all four temporal bounds as {value, bound_state}.",
      "tested_by": "Q7, R8"
    },
    {
      "id": "F-REQ-3",
      "requirement": "evidence_state, verification_result and execution_status are three separate fields.",
      "tested_by": "Q7, Q8"
    },
    {
      "id": "F-REQ-4",
      "requirement": "MANDATORY ftro:display_name on every entity, read by no query.",
      "tested_by": "R11"
    },
    {
      "id": "F-REQ-5",
      "requirement": "Entity count is declared in the fixture so R11's enumeration can be checked against it.",
      "tested_by": "R11 validation_rule"
    }
  ]
